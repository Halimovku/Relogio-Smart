    def detect_vm_advanced(self):
        # Verifica processos
        vm_procs = ['vmware.exe', 'vboxservice.exe', 'vboxtray.exe', 'vmtoolsd.exe', 'xenservice.exe']
        for proc in psutil.process_iter(['name']):
            if proc.info['name'].lower() in vm_procs:
                return True
        
        # Verifica hardware (Serial da placa mãe ou disco)
        try:
            c = wmi.WMI()
            for board in c.Win32_BaseBoard():
                if "VMware" in board.SerialNumber or "VirtualBox" in board.SerialNumber:
                    return True
            for disk in c.Win32_DiskDrive():
                if "VMware" in disk.Model or "VirtualBox" in disk.Model:
                    return True
        except Exception:
            pass
            
        return False

    def check_debugger(self):
