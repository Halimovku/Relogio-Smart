        acoes.addStretch(1)
        acoes.addWidget(btn_del)

        dica = QLabel("Marque ou desmarque para ativar/desativar. Alarmes “uma vez” desligam sozinhos depois de tocar.")
        dica.setStyleSheet(f"color: {COR_MUTED};")

        raiz.addLayout(form)
        raiz.addWidget(self.lista, 1)
        raiz.addLayout(acoes)
        raiz.addWidget(dica)

        self._recarregar()
        pulso.tick.connect(self._on_tick)

    def _recarregar(self):
        self._reconstruindo = True
        self.lista.clear()
        for al in self.cfg["alarmes"]:
            nome = al["rotulo"] or "Alarme"
            texto = f"⏰  {al['hora']}    {nome}    •    {REPETICOES.get(al['repeticao'], '')}"
            item = QListWidgetItem(texto)
            item.setFlags(item.flags() | Qt.ItemFlag.ItemIsUserCheckable)
            item.setCheckState(Qt.CheckState.Checked if al["ativo"] else Qt.CheckState.Unchecked)
            self.lista.addItem(item)
        self._reconstruindo = False

    def _item_mudou(self, item: QListWidgetItem):
        if self._reconstruindo:
            return
        linha = self.lista.row(item)
        if 0 <= linha < len(self.cfg["alarmes"]):
            self.cfg["alarmes"][linha]["ativo"] = item.checkState() == Qt.CheckState.Checked
            salvar_config(self.cfg)

    def _adicionar(self):
        self.cfg["alarmes"].append({
            "hora": self.hora.time().toString("HH:mm"),
            "rotulo": self.rotulo.text().strip(),
            "repeticao": self.repeticao.currentData(),
            "ativo": True,
        })
        self.cfg["alarmes"].sort(key=lambda a: a["hora"])
        salvar_config(self.cfg)
        self.rotulo.clear()
        self._recarregar()

    def _remover(self):
        linha = self.lista.currentRow()
        if 0 <= linha < len(self.cfg["alarmes"]):
            del self.cfg["alarmes"][linha]
            salvar_config(self.cfg)
            self._recarregar()

    def _on_tick(self, agora: datetime):
        minuto = agora.strftime("%Y-%m-%d %H:%M")
        if minuto != self._ultimo_minuto:  # verifica uma vez por minuto
            self._ultimo_minuto = minuto
            hhmm = agora.strftime("%H:%M")
            mudou = False
            for al in self.cfg["alarmes"]:
                if not al["ativo"] or al["hora"] != hhmm:
                    continue
                if al["repeticao"] == "uteis" and agora.weekday() >= 5:
                    continue
                self._disparar(al["rotulo"] or "Alarme", hhmm)
                if al["repeticao"] == "uma_vez":
                    al["ativo"] = False
                    mudou = True
            if mudou:
                salvar_config(self.cfg)
                self._recarregar()

        for item in [s for s in self._sonecas if agora >= s[0]]:
            self._sonecas.remove(item)
            self._disparar(item[1], agora.strftime("%H:%M"))

    def _disparar(self, titulo: str, hora: str):
        dlg = DialogoAlarme("⏰ Alarme", f"{titulo}\n{hora}", com_soneca=True, parent=self)
        dlg.soneca_pedida.connect(lambda _=None, t=titulo: self._agendar_soneca(t))
        abrir_dialogo(dlg)

    def _agendar_soneca(self, titulo: str):
        quando = datetime.now() + timedelta(minutes=self.soneca.value())
        self._sonecas.append((quando, titulo))


class AbaCronometro(QWidget):
    def __init__(self):
        super().__init__()
        self._acumulado = 0.0
        self._inicio: float | None = None
        self._ultimo_parcial = 0.0
        self._voltas = 0

        self._timer = QTimer(self)
        self._timer.setInterval(30)
        self._timer.timeout.connect(self._atualizar)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(30, 24, 30, 24)
        raiz.setSpacing(14)

        self.display = QLabel("00:00.00")
        self.display.setAlignment(Qt.AlignmentFlag.AlignCenter)
        fonte = QFont("Consolas", 64)
        fonte.setBold(True)
        self.display.setFont(fonte)
        raiz.addWidget(self.display)

        botoes = QHBoxLayout()
        self.btn_iniciar = QPushButton("Iniciar")
        self.btn_iniciar.setObjectName("primario")
        self.btn_iniciar.setMinimumWidth(130)
        self.btn_iniciar.clicked.connect(self._alternar)
        btn_volta = QPushButton("Volta (lap)")
        btn_volta.clicked.connect(self._volta)
        btn_zerar = QPushButton("Zerar")
        btn_zerar.clicked.connect(self._zerar)
        botoes.addStretch(1)
        for b in (self.btn_iniciar, btn_volta, btn_zerar):
            botoes.addWidget(b)
        botoes.addStretch(1)
        raiz.addLayout(botoes)

        self.lista = QListWidget()
        raiz.addWidget(self.lista, 1)

    def _decorrido(self) -> float:
        if self._inicio is None:
            return self._acumulado
        return self._acumulado + (time.perf_counter() - self._inicio)

    def _atualizar(self):
        self.display.setText(formata_cronometro(self._decorrido()))

    def _alternar(self):
        if self._inicio is None:
            self._inicio = time.perf_counter()
            self._timer.start()
            self.btn_iniciar.setText("Pausar")
        else:
            self._acumulado = self._decorrido()
            self._inicio = None
            self._timer.stop()
            self.btn_iniciar.setText("Continuar")
        self._atualizar()

    def _volta(self):
        total = self._decorrido()
        if total <= 0:
            return
        self._voltas += 1
        parcial = total - self._ultimo_parcial
        self._ultimo_parcial = total
        self.lista.insertItem(
            0,
            f"Volta {self._voltas:02d}    total {formata_cronometro(total)}    parcial {formata_cronometro(parcial)}",
        )

    def _zerar(self):
        self._timer.stop()
        self._acumulado = 0.0
        self._inicio = None
        self._ultimo_parcial = 0.0
        self._voltas = 0
        self.lista.clear()
        self.btn_iniciar.setText("Iniciar")
        self._atualizar()


class AbaTemporizador(QWidget):
    def __init__(self, cfg: dict):
        super().__init__()
        self.cfg = cfg
        self._restante = 0.0
        self._fim: float | None = None  # instante (perf_counter) em que termina
        self._pomodoro = False
        self._fase = "Trabalho"
        self._sessoes = 0

        self._timer = QTimer(self)
        self._timer.setInterval(100)
        self._timer.timeout.connect(self._tick)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(30, 24, 30, 24)
        raiz.setSpacing(14)

        self.display = QLabel("00:00:00")
        self.display.setAlignment(Qt.AlignmentFlag.AlignCenter)
        fonte = QFont("Consolas", 64)
        fonte.setBold(True)
        self.display.setFont(fonte)
        self.estado = QLabel("")
        self.estado.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.estado.setStyleSheet(f"color: {COR_MUTED}; font-size: 11pt;")
        raiz.addWidget(self.display)
        raiz.addWidget(self.estado)

        # Entrada manual
        manual = QHBoxLayout()
        self.sp_h = QSpinBox()
        self.sp_h.setRange(0, 23)
        self.sp_h.setSuffix(" h")
        self.sp_m = QSpinBox()
        self.sp_m.setRange(0, 59)
        self.sp_m.setSuffix(" min")
        self.sp_m.setValue(10)
        self.sp_s = QSpinBox()
        self.sp_s.setRange(0, 59)
        self.sp_s.setSuffix(" s")
        for sp in (self.sp_h, self.sp_m, self.sp_s):
            sp.valueChanged.connect(self._ajuste_manual)
            manual.addWidget(sp)
        manual.addStretch(1)

        # Controles
        controles = QHBoxLayout()
        self.btn_play = QPushButton("Iniciar")
        self.btn_play.setObjectName("primario")
        self.btn_play.setMinimumWidth(130)
        self.btn_play.clicked.connect(self._play)
        btn_zerar = QPushButton("Zerar")
        btn_zerar.clicked.connect(self._zerar)
        controles.addStretch(1)
        controles.addWidget(self.btn_play)
        controles.addWidget(btn_zerar)
        controles.addStretch(1)

        # Atalhos
        atalhos = QHBoxLayout()
        atalhos.addWidget(QLabel("Atalhos:"))
        for minutos in (1, 5, 10, 15, 25, 45):
            b = QPushButton(f"{minutos} min")
            b.clicked.connect(lambda _=False, m=minutos: self._preset(m))
            atalhos.addWidget(b)
        atalhos.addStretch(1)

        # Pomodoro
        pomo = QHBoxLayout()
        self.btn_pomo = QPushButton("🍅 Iniciar Pomodoro")
        self.btn_pomo.clicked.connect(self._alternar_pomodoro)
        pomo.addWidget(self.btn_pomo)
        pomo.addSpacing(20)
        pomo.addWidget(QLabel("Foco:"))
        pomo.addWidget(self._spin_pomo("trabalho", 1, 180, "min"))
        pomo.addWidget(QLabel("Pausa:"))
        pomo.addWidget(self._spin_pomo("pausa", 1, 60, "min"))
        pomo.addStretch(1)

        raiz.addLayout(manual)
        raiz.addLayout(controles)
        raiz.addLayout(atalhos)
        raiz.addSpacing(10)
        raiz.addLayout(pomo)
        raiz.addStretch(1)

        self._zerar()


    def _spin_pomo(self, chave: str, minimo: int, maximo: int, sufixo: str) -> QSpinBox:
        sp = QSpinBox()
        sp.setRange(minimo, maximo)
        sp.setSuffix(f" {sufixo}")
        sp.setValue(int(self.cfg["pomodoro"][chave]))
        sp.valueChanged.connect(lambda v, k=chave: self._salvar_pomo(k, v))
        return sp

    def _salvar_pomo(self, chave: str, valor: int):
        self.cfg["pomodoro"][chave] = int(valor)
        salvar_config(self.cfg)

    def _duracao_manual(self) -> float:
        return self.sp_h.value() * 3600 + self.sp_m.value() * 60 + self.sp_s.value()

    def _mostrar(self, segundos: float):
        self.display.setText(formata_hms(segundos))

    def _ajuste_manual(self, *_):
        if self._fim is None and not self._pomodoro:
            self._restante = self._duracao_manual()
            self._mostrar(self._restante)

    def _atualizar_estado(self):
        if self._pomodoro:
            self.estado.setText(f"🍅 {self._fase}   •   sessões de foco concluídas: {self._sessoes}")
        else:
            self.estado.setText("")


    def _preset(self, minutos: int):
        self.sp_h.setValue(minutos // 60)
        self.sp_m.setValue(minutos % 60)
        self.sp_s.setValue(0)
        self._zerar()

    def _zerar(self):
        self._timer.stop()
        self._fim = None
        self._pomodoro = False
        self._restante = self._duracao_manual()
        self.btn_play.setText("Iniciar")
        self.btn_pomo.setText("🍅 Iniciar Pomodoro")
        self._atualizar_estado()
        self._mostrar(self._restante)

    def _correr(self):
        self._fim = time.perf_counter() + self._restante
        self._timer.start()

    def _play(self):
        if self._fim is not None:  # está rodando → pausa
            self._restante = max(0.0, self._fim - time.perf_counter())
            self._fim = None
            self._timer.stop()
            self.btn_play.setText("Continuar")
            self._mostrar(self._restante)
            return
        if self._restante <= 0:
            self._restante = self._duracao_manual()
        if self._restante <= 0:
            return
        self._correr()
        self.btn_play.setText("Pausar")

    def _tick(self):
        restante = self._fim - time.perf_counter()
        if restante > 0:
            self._mostrar(restante)
            return
        self._timer.stop()
        self._fim = None
        self._restante = 0.0
        self._mostrar(0)
        self._terminou()

    def _terminou(self):
        if self._pomodoro:
            self._proxima_fase()
        else:
            self.btn_play.setText("Iniciar")
            abrir_dialogo(DialogoAlarme("⏲ Temporizador", "Tempo esgotado!", com_soneca=False, parent=self))

    def _alternar_pomodoro(self):
        if self._pomodoro:
            self._zerar()
            return
        self._pomodoro = True
        self._fase = "Trabalho"
        self._sessoes = 0
        self._restante = self.cfg["pomodoro"]["trabalho"] * 60.0
        self._atualizar_estado()
        self._correr()
        self.btn_play.setText("Pausar")
        self.btn_pomo.setText("⏹ Parar Pomodoro")

    def _proxima_fase(self):
        p = self.cfg["pomodoro"]
        if self._fase == "Trabalho":
            self._sessoes += 1
            if self._sessoes % p["ciclos"] == 0:
                self._fase, minutos = "Pausa longa", p["pausa_longa"]
            else:
                self._fase, minutos = "Pausa", p["pausa"]
        else:
            self._fase, minutos = "Trabalho", p["trabalho"]
        self._restante = minutos * 60.0
        self._atualizar_estado()
        abrir_dialogo(DialogoAlarme("🍅 Pomodoro", f"Agora: {self._fase} ({minutos} min)",
                                    com_soneca=False, parent=self))
        self._correr()


class AbaCalendario(QWidget):
    def __init__(self, pulso: Pulso):
        super().__init__()
        hoje = date.today()

        raiz = QHBoxLayout(self)
        raiz.setContentsMargins(24, 20, 24, 20)
        raiz.setSpacing(24)

        self.cal = QCalendarWidget()
        self.cal.setLocale(QLocale(QLocale.Language.Portuguese, QLocale.Country.Brazil))
        self.cal.setGridVisible(True)
        self.cal.setNavigationBarVisible(True)
        self.cal.setHorizontalHeaderFormat(QCalendarWidget.HorizontalHeaderFormat.ShortDayNames)
        self.cal.setVerticalHeaderFormat(QCalendarWidget.VerticalHeaderFormat.NoVerticalHeader)
        self._marcar_feriados(range(hoje.year - 1, hoje.year + 4))
        raiz.addWidget(self.cal, 3)

        painel = QVBoxLayout()
        painel.setSpacing(8)
        self.titulo = QLabel()
        fonte = QFont("Segoe UI", 18)
        fonte.setBold(True)
        self.titulo.setFont(fonte)
        self.titulo.setWordWrap(True)
        self.detalhes = QLabel()
        self.detalhes.setStyleSheet(f"color: {COR_MUTED};")
        self.detalhes.setWordWrap(True)
        self.rotulo_feriados = QLabel()
        self.rotulo_feriados.setStyleSheet("font-weight: bold; margin-top: 12px;")
        self.lista = QListWidget()
        painel.addWidget(self.titulo)
        painel.addWidget(self.detalhes)
        painel.addWidget(self.rotulo_feriados)
        painel.addWidget(self.lista, 1)
        raiz.addLayout(painel, 2)

        self.cal.selectionChanged.connect(self._atualizar_info)
        self._atualizar_info()

    def _marcar_feriados(self, anos):
        fmt = QTextCharFormat()
        fmt.setForeground(QColor(COR_FERIADO))
        fmt.setFontWeight(700)
        for ano in anos:
            for dia in feriados_nacionais(ano):
                self.cal.setDateTextFormat(QDate(dia.year, dia.month, dia.day), fmt)

    def _atualizar_info(self):
        q = self.cal.selectedDate()
        dia = date(q.year(), q.month(), q.day())
        hoje = date.today()
        feriados = feriados_nacionais(dia.year)

        self.titulo.setText(f"{DIAS_SEMANA[dia.weekday()].capitalize()}, {dia.day} de "
                            f"{MESES[dia.month - 1]} de {dia.year}")

        partes = [f"dia {dia.timetuple().tm_yday} do ano", f"semana ISO {dia.isocalendar().week}"]
        delta = (dia - hoje).days
        if delta == 0:
            partes.append("é hoje")
        elif delta > 0:
            partes.append(f"faltam {delta} dia{'s' if delta != 1 else ''}")
        else:
            partes.append(f"há {-delta} dia{'s' if delta != -1 else ''}")
        if dia in feriados:
            partes.append(f"🎉 {feriados[dia]}")
        self.detalhes.setText("  •  ".join(partes))

        self.rotulo_feriados.setText(f"Feriados de {dia.year}")
        self.lista.clear()
        for d, nome in sorted(feriados.items()):
            self.lista.addItem(f"{d:%d/%m}  ({DIAS_CURTOS[d.weekday()]})  —  {nome}")


class MiniRelogio(QWidget):
    def __init__(self, pulso: Pulso, ao_restaurar):
        super().__init__()
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint
                            | Qt.WindowType.WindowStaysOnTopHint
                            | Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setStyleSheet("background: transparent;")
        self.setFixedSize(240, 112)
        self.setToolTip("Arraste para mover • duplo clique para voltar à janela principal")
        self._ao_restaurar = ao_restaurar
        self._arrasto = None

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(14, 12, 14, 12)
        raiz.setSpacing(0)

        self.hora = QLabel("00:00:00")
        self.hora.setAlignment(Qt.AlignmentFlag.AlignCenter)
        fonte = QFont("Consolas", 30)
        fonte.setBold(True)
        self.hora.setFont(fonte)

        self.data = QLabel("")
        self.data.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.data.setStyleSheet(f"color: {COR_MUTED}; font-size: 9pt;")

        raiz.addWidget(self.hora)
        raiz.addWidget(self.data)
        pulso.tick.connect(self._on_tick)

    def _on_tick(self, agora: datetime):
        self.hora.setText(agora.strftime("%H:%M:%S"))
        self.data.setText(f"{DIAS_CURTOS[agora.weekday()]}  •  {agora.day:02d}/{agora.month:02d}/{agora.year}")

    def paintEvent(self, _evento):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(caneta("#30363d", 1))
        p.setBrush(QColor(13, 17, 23, 235))
        p.drawRoundedRect(QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5), 18, 18)
        p.end()

    def mousePressEvent(self, evento):
        if evento.button() == Qt.MouseButton.LeftButton:
            self._arrasto = evento.globalPosition().toPoint() - self.frameGeometry().topLeft()

    def mouseMoveEvent(self, evento):
        if self._arrasto is not None and evento.buttons() & Qt.MouseButton.LeftButton:
            self.move(evento.globalPosition().toPoint() - self._arrasto)

    def mouseReleaseEvent(self, _evento):
        self._arrasto = None

    def mouseDoubleClickEvent(self, _evento):
        self._ao_restaurar()

    def contextMenuEvent(self, evento):
        menu = QMenu(self)
        menu.addAction("Restaurar janela principal").triggered.connect(lambda _=False: self._ao_restaurar())
        menu.addAction("Sair").triggered.connect(lambda _=False: QApplication.quit())
        menu.exec(evento.globalPos())

