def carregar_config() -> dict:
    cfg = json.loads(json.dumps(CONFIG_PADRAO))  # cópia profunda
    try:
        salvo = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        for chave in cfg:
            if chave in salvo:
                cfg[chave] = salvo[chave]
    except (OSError, ValueError, TypeError):
        pass  # primeiro uso ou arquivo corrompido: usa os padrões
    return cfg


def salvar_config(cfg: dict) -> None:
    try:
        APP_DIR.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")
    except OSError as erro:
        print(f"[aviso] não consegui salvar a configuração: {erro}", file=sys.stderr)


