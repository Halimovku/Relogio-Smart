def formata_hms(segundos: float) -> str:
    s = int(math.ceil(max(0.0, segundos)))
    h, resto = divmod(s, 3600)
    m, s = divmod(resto, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def formata_cronometro(segundos: float) -> str:
    cs = int(max(0.0, segundos) * 100)
    h, resto = divmod(cs, 360_000)
    m, resto = divmod(resto, 6_000)
    s, c = divmod(resto, 100)
    if h:
        return f"{h:02d}:{m:02d}:{s:02d}.{c:02d}"
    return f"{m:02d}:{s:02d}.{c:02d}"


def pascoa(ano: int) -> date:
    """Domingo de Páscoa (algoritmo de Meeus/Jones/Butcher)."""
    a = ano % 19
    b, c = divmod(ano, 100)
    d, e = divmod(b, 4)
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i, k = divmod(c, 4)
    j = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * j) // 451
    mes, dia = divmod(h + j - 7 * m + 114, 31)
    return date(ano, mes, dia + 1)


def feriados_nacionais(ano: int) -> dict[date, str]:
    pas = pascoa(ano)
    feriados = {date(ano, m, d): nome for (m, d), nome in FERIADOS_FIXOS.items()}
    feriados[pas - timedelta(days=2)] = "Sexta-feira Santa"
    feriados[pas - timedelta(days=47)] = "Carnaval (ponto facultativo)"
    feriados[pas + timedelta(days=60)] = "Corpus Christi (ponto facultativo)"
    return feriados


def proximo_feriado(hoje: date) -> tuple[str, date]:
    for ano in (hoje.year, hoje.year + 1):
        for dia, nome in sorted(feriados_nacionais(ano).items()):
            if dia >= hoje:
                return nome, dia
    return "—", hoje


def caneta(cor, largura: float = 1.0, cap=Qt.PenCapStyle.FlatCap) -> QPen:
    pincel = QPen(QColor(cor))
    pincel.setWidthF(largura)
    pincel.setCapStyle(cap)
    return pincel


class Pulso(QObject):
    """Emite a hora atual ~10 vezes por segundo. Todas as abas se inscrevem aqui."""

    tick = Signal(object)

    def __init__(self):
        super().__init__()
        self._timer = QTimer(self)
        self._timer.setInterval(100)
        self._timer.timeout.connect(self._emitir)
        self._timer.start()

    def _emitir(self):
        self.tick.emit(datetime.now())


_ABERTOS: list[QDialog] = []


def abrir_dialogo(dlg: QDialog) -> None:
    _ABERTOS.append(dlg)

    def fechar(_=None):
        if dlg in _ABERTOS:
            _ABERTOS.remove(dlg)
        dlg.deleteLater()

    dlg.finished.connect(fechar)
    dlg.show()
    dlg.raise_()
    dlg.activateWindow()


class DialogoAlarme(QDialog):
    soneca_pedida = Signal()

    def __init__(self, titulo: str, mensagem: str, com_soneca: bool = True, parent=None):
        super().__init__(parent)
        self.setWindowTitle(titulo)
        self.setWindowFlags(Qt.WindowType.Window | Qt.WindowType.WindowStaysOnTopHint)
        self.setMinimumWidth(340)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 24, 28, 20)
        layout.setSpacing(14)

        icone = QLabel("⏰")
        icone.setAlignment(Qt.AlignmentFlag.AlignCenter)
        icone.setStyleSheet("font-size: 44pt;")

        texto = QLabel(mensagem)
        texto.setAlignment(Qt.AlignmentFlag.AlignCenter)
        fonte = QFont("Segoe UI", 15)
        fonte.setBold(True)
        texto.setFont(fonte)

        layout.addWidget(icone)
        layout.addWidget(texto)

        botoes = QHBoxLayout()
        if com_soneca:
            btn_soneca = QPushButton("Soneca")
            btn_soneca.clicked.connect(self._pedir_soneca)
            botoes.addWidget(btn_soneca)
        btn_ok = QPushButton("Desligar" if com_soneca else "OK")
        btn_ok.setObjectName("primario")
        btn_ok.clicked.connect(self.accept)
        botoes.addWidget(btn_ok)
        layout.addLayout(botoes)

        # Bipe a cada 1,2 s por até 60 s
        self._beep = QTimer(self)
        self._beep.setInterval(1200)
        self._beep.timeout.connect(lambda: QApplication.beep())
        self._beep.start()
        self._limite = QTimer(self)
        self._limite.setSingleShot(True)
        self._limite.timeout.connect(self._beep.stop)
        self._limite.start(60_000)
        QApplication.beep()

    def _pedir_soneca(self):
        self.soneca_pedida.emit()
        self.accept()

    def done(self, resultado):
        self._beep.stop()
        super().done(resultado)

class RelogioAnalogico(QWidget):
    def __init__(self):
        super().__init__()
        self._agora = datetime.now()
        self.setMinimumSize(260, 260)

    def atualizar(self, agora: datetime):
        self._agora = agora
        self.update()

    def paintEvent(self, _evento):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        lado = min(self.width(), self.height())
        p.translate(self.width() / 2, self.height() / 2)
        p.scale(lado / 240, lado / 240)

        ag = self._agora
        seg = ag.second + ag.microsecond / 1_000_000

        # Mostrador
        p.setPen(caneta("#2a3342", 2))
        p.setBrush(QColor("#0d1117"))
        p.drawEllipse(QPointF(0, 0), 116, 116)

        # Anel de progresso dos segundos
        p.setPen(caneta(COR_VERMELHO, 3, Qt.PenCapStyle.RoundCap))
        p.drawArc(QRectF(-108, -108, 216, 216), 90 * 16, -int(seg / 60 * 360 * 16))

        # Marcas de minuto e de hora
        for i in range(60):
            p.save()
            p.rotate(i * 6)
            if i % 5 == 0:
                p.setPen(caneta(COR_TEXTO, 3.5, Qt.PenCapStyle.RoundCap))
                p.drawLine(QPointF(0, -100), QPointF(0, -88))
            else:
                p.setPen(caneta("#3b4656", 1.2))
                p.drawLine(QPointF(0, -100), QPointF(0, -95))
            p.restore()

        # Algarismos
        fonte = QFont("Segoe UI", 13)
        fonte.setBold(True)
        p.setFont(fonte)
        p.setPen(QColor(COR_TEXTO))
        for n in range(1, 13):
            ang = math.radians(n * 30)
            x, y = math.sin(ang) * 72, -math.cos(ang) * 72
            p.drawText(QRectF(x - 20, y - 14, 40, 28), Qt.AlignmentFlag.AlignCenter, str(n))

        # Ponteiros
        self._ponteiro(p, (ag.hour % 12 + ag.minute / 60 + seg / 3600) * 30, 54, 7, QColor(COR_TEXTO))
        self._ponteiro(p, (ag.minute + seg / 60) * 6, 84, 4.5, QColor(COR_TEXTO))

        p.save()
        p.rotate(seg * 6)
        p.setPen(caneta(COR_VERMELHO, 1.6, Qt.PenCapStyle.RoundCap))
        p.drawLine(QPointF(0, 16), QPointF(0, -94))
        p.restore()

        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(COR_VERMELHO))
        p.drawEllipse(QPointF(0, 0), 5, 5)
        p.end()

    @staticmethod
    def _ponteiro(p: QPainter, angulo: float, comprimento: float, largura: float, cor: QColor):
        p.save()
        p.rotate(angulo)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(cor)
        pontos = [
            QPointF(-largura, 12),
            QPointF(-largura, -comprimento + largura * 2),
            QPointF(0, -comprimento),
            QPointF(largura, -comprimento + largura * 2),
            QPointF(largura, 12),
        ]
        p.drawPolygon(QPolygonF(pontos))
        p.restore()


class AbaRelogio(QWidget):
    def __init__(self, pulso: Pulso):
        super().__init__()
        self._usuario = nome_usuario()

        raiz = QHBoxLayout(self)
        raiz.setContentsMargins(36, 24, 36, 24)
        raiz.setSpacing(40)

        self.analogico = RelogioAnalogico()
        raiz.addWidget(self.analogico, 5)

        painel = QVBoxLayout()
        painel.setSpacing(8)

        self.saudacao = QLabel()
        self.saudacao.setStyleSheet(f"color: {COR_MUTED}; font-size: 13pt;")

        self.digital = QLabel("00:00:00")
        fonte = QFont("Consolas", 66)
        fonte.setBold(True)
        self.digital.setFont(fonte)

        self.data = QLabel()
        self.data.setStyleSheet("font-size: 17pt;")

        self.progresso = QProgressBar()
        self.progresso.setRange(0, 1000)
        self.progresso.setFormat("Dia %p% concluído")

        self.info = QLabel()
        self.info.setStyleSheet(f"color: {COR_MUTED};")
        self.info.setWordWrap(True)

        painel.addStretch(1)
        painel.addWidget(self.saudacao)
        painel.addWidget(self.digital)
        painel.addWidget(self.data)
        painel.addSpacing(12)
        painel.addWidget(self.progresso)
        painel.addWidget(self.info)
        painel.addStretch(1)
        raiz.addLayout(painel, 6)

        pulso.tick.connect(self._on_tick)
        self._on_tick(datetime.now())

    def _on_tick(self, agora: datetime):
        self.analogico.atualizar(agora)
        hoje = agora.date()

        h = agora.hour
        if 5 <= h < 12:
            saud = "Bom dia"
        elif 12 <= h < 18:
            saud = "Boa tarde"
        else:
            saud = "Boa noite"
        self.saudacao.setText(f"{saud}, {self._usuario}!" if self._usuario else f"{saud}!")

        self.digital.setText(agora.strftime("%H:%M:%S"))
        self.data.setText(
            f"{DIAS_SEMANA[agora.weekday()].capitalize()}, {agora.day} de "
            f"{MESES[agora.month - 1]} de {agora.year}"
        )

        segundos_dia = agora.hour * 3600 + agora.minute * 60 + agora.second + agora.microsecond / 1e6
        self.progresso.setValue(int(segundos_dia / 86400 * 1000))

        fim_do_ano = (date(agora.year, 12, 31) - hoje).days
        nome_fer, data_fer = proximo_feriado(hoje)
        faltam = (data_fer - hoje).days
        quando = "hoje" if faltam == 0 else f"em {faltam} dia{'s' if faltam != 1 else ''}"
        self.info.setText(
            f"Dia {agora.timetuple().tm_yday} do ano  •  semana ISO {agora.isocalendar().week}  •  "
            f"faltam {fim_do_ano} dias para o fim de {agora.year}\n"
            f"Próximo feriado: {nome_fer} ({data_fer:%d/%m}), {quando}"
        )


class AbaMundo(QWidget):
    COLUNAS = ["Cidade", "Fuso", "Hora", "Data", "Diferença vs. este PC"]

    def __init__(self, pulso: Pulso, cfg: dict):
        super().__init__()
        self.cfg = cfg
        self._zonas_disponiveis = set(available_timezones())
        self._zonas: list = []  # ZoneInfo ou None (fuso inválido), na ordem da tabela

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(30, 24, 30, 24)
        raiz.setSpacing(14)

        topo = QHBoxLayout()
        self.combo = QComboBox()
        self.combo.setEditable(True)
        self.combo.setInsertPolicy(QComboBox.InsertPolicy.NoInsert)
        self.combo.addItems(sorted(self._zonas_disponiveis))
        self.combo.setMaxVisibleItems(18)
        completer = self.combo.completer()
        completer.setFilterMode(Qt.MatchFlag.MatchContains)
        completer.setCaseSensitivity(Qt.CaseSensitivity.CaseInsensitive)
        self.combo.setCurrentIndex(self.combo.findText("America/Sao_Paulo"))
        self.combo.lineEdit().returnPressed.connect(self._adicionar)

        btn_add = QPushButton("Adicionar fuso")
        btn_add.setObjectName("primario")
        btn_add.clicked.connect(self._adicionar)
        btn_del = QPushButton("Remover selecionado")
        btn_del.clicked.connect(self._remover)

        topo.addWidget(QLabel("Cidade / fuso:"))
        topo.addWidget(self.combo, 1)
        topo.addWidget(btn_add)
        topo.addWidget(btn_del)
        raiz.addLayout(topo)

        self.tabela = QTableWidget(0, len(self.COLUNAS))
        self.tabela.setHorizontalHeaderLabels(self.COLUNAS)
        self.tabela.verticalHeader().setVisible(False)
        self.tabela.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.tabela.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
        self.tabela.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.tabela.setAlternatingRowColors(True)
        self.tabela.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)
        raiz.addWidget(self.tabela, 1)

        self.aviso = QLabel("")
        self.aviso.setStyleSheet(f"color: {COR_MUTED};")
        raiz.addWidget(self.aviso)

        self._recarregar()
        pulso.tick.connect(self._on_tick)

    def _recarregar(self):
        self._zonas = []
        self.tabela.setRowCount(0)
        for linha, nome in enumerate(self.cfg["fusos"]):
            self.tabela.insertRow(linha)
            cidade = nome.split("/")[-1].replace("_", " ")
            for col, texto in enumerate((cidade, nome, "", "", "")):
                self.tabela.setItem(linha, col, QTableWidgetItem(texto))
            try:
                self._zonas.append(ZoneInfo(nome))
            except (ZoneInfoNotFoundError, ValueError):
                self._zonas.append(None)
        self._on_tick(datetime.now())

    def _texto(self, linha: int, col: int, texto: str):
        item = self.tabela.item(linha, col)
        if item is not None and item.text() != texto:
            item.setText(texto)

    def _on_tick(self, agora: datetime):
        local = agora.astimezone()
        for linha, zona in enumerate(self._zonas):
            if zona is None:
                self._texto(linha, 2, "fuso inválido")
                continue
            t = local.astimezone(zona)
            dif = (t.utcoffset() - local.utcoffset()).total_seconds() / 3600
            self._texto(linha, 2, t.strftime("%H:%M:%S"))
            self._texto(linha, 3, t.strftime("%d/%m/%Y"))
            self._texto(linha, 4, "mesmo horário" if dif == 0 else f"{dif:+g} h")

    def _adicionar(self):
        nome = self.combo.currentText().strip()
        if nome not in self._zonas_disponiveis:
            self.aviso.setText(f"Fuso não encontrado: “{nome}”. Tente digitar parte do nome (ex.: Tokyo).")
            return
        if nome in self.cfg["fusos"]:
            self.aviso.setText("Esse fuso já está na lista.")
            return
        self.cfg["fusos"].append(nome)
        salvar_config(self.cfg)
        self.aviso.setText(f"Adicionado: {nome}")
        self._recarregar()

    def _remover(self):
        linha = self.tabela.currentRow()
        if not 0 <= linha < len(self.cfg["fusos"]):
            self.aviso.setText("Selecione uma linha para remover.")
            return
        removido = self.cfg["fusos"].pop(linha)
        salvar_config(self.cfg)
        self.aviso.setText(f"Removido: {removido}")
        self._recarregar()


