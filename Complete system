# ----------------------------------------------------------------------------
# Configuração
# ----------------------------------------------------------------------------
def _mesclar(padrao, salvo):
    """Preenche com o padrão o que faltar no arquivo salvo, inclusive em sub-chaves."""
    if isinstance(padrao, dict):
        salvo = salvo if isinstance(salvo, dict) else {}
        return {chave: _mesclar(valor, salvo.get(chave, valor)) for chave, valor in padrao.items()}
    if padrao is None:
        return salvo
    if salvo is None or type(salvo) is not type(padrao):
        return padrao
    return salvo


def _hora_valida(valor) -> bool:
    return isinstance(valor, str) and re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", valor) is not None


def _limpar_alarmes(alarmes) -> list:
    validos = []
    for al in alarmes if isinstance(alarmes, list) else []:
        if isinstance(al, dict) and _hora_valida(al.get("hora")) and al.get("repeticao") in REPETICOES:
            validos.append({
                "hora": al["hora"],
                "rotulo": str(al.get("rotulo", ""))[:60],
                "repeticao": al["repeticao"],
                "ativo": bool(al.get("ativo", True)),
            })
    validos.sort(key=lambda a: a["hora"])
    return validos


def carregar_config() -> dict:
    try:
        salvo = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        salvo = {}
    cfg = _mesclar(copy.deepcopy(CONFIG_PADRAO), salvo)
    cfg["alarmes"] = _limpar_alarmes(cfg["alarmes"])
    cfg["soneca_min"] = min(max(int(cfg["soneca_min"]), 1), 60)
    return cfg


def salvar_config(cfg: dict) -> None:
    try:
        APP_DIR.mkdir(parents=True, exist_ok=True)
        temporario = CONFIG_FILE.with_suffix(".tmp")
        temporario.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding="utf-8")
        temporario.replace(CONFIG_FILE)  # troca atômica: não corrompe o arquivo se faltar energia
    except OSError as erro:
        print(f"[aviso] não consegui salvar a configuração: {erro}", file=sys.stderr)


