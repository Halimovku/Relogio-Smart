def nome_usuario() -> str:
    try:
        return getuser().capitalize()
    except Exception:
        return ""


def formata_hms(segundos: float) -> str:
    s = int(math.ceil(max(0.0, segundos)))
    h, resto = divmod(s, 3600)
    m, s = divmod(resto, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def formata_cronometro(segundos: float) -> str:
    cs = int(max(0.0, segundos) * 100)
    h, resto = divmod(cs, 360_000)
    m, resto = divmod(resto, 6_000)
    s, c = divmod(resto, 100)
    if h:
        return f"{h:02d}:{m:02d}:{s:02d}.{c:02d}"
    return f"{m:02d}:{s:02d}.{c:02d}"


def pascoa(ano: int) -> date:
    """Domingo de Páscoa (algoritmo de Meeus/Jones/Butcher)."""
    a = ano % 19
    b, c = divmod(ano, 100)
    d, e = divmod(b, 4)
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i, k = divmod(c, 4)
    j = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * j) // 451
    mes, dia = divmod(h + j - 7 * m + 114, 31)
    return date(ano, mes, dia + 1)


@lru_cache(maxsize=32)
def feriados_nacionais(ano: int) -> dict:
    """Feriados nacionais do ano. O resultado é cacheado: não modifique o dicionário."""
    pas = pascoa(ano)
    feriados = {date(ano, m, d): nome for (m, d), nome in FERIADOS_FIXOS.items()}
    feriados[pas - timedelta(days=2)] = "Sexta-feira Santa"
    feriados[pas - timedelta(days=47)] = "Carnaval (ponto facultativo)"
    feriados[pas + timedelta(days=60)] = "Corpus Christi (ponto facultativo)"
    return feriados


@lru_cache(maxsize=8)
def proximo_feriado(hoje: date) -> tuple:
    for ano in (hoje.year, hoje.year + 1):
        for dia, nome in sorted(feriados_nacionais(ano).items()):
            if dia >= hoje:
                return nome, dia
    return "—", hoje


