        self.lista.clear()
        for al in self.cfg["alarmes"]:
            nome = al["rotulo"] or "Alarme"
            texto = f"⏰  {al['hora']}    {nome}    •    {REPETICOES.get(al['repeticao'], '')}"
            item = QListWidgetItem(texto)
            item.setFlags(item.flags() | Qt.ItemFlag.ItemIsUserCheckable)
            item.setCheckState(Qt.CheckState.Checked if al["ativo"] else Qt.CheckState.Unchecked)
            self.lista.addItem(item)
