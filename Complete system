# ----------------------------------------------------------------------------
# Pulso central: uma fonte de tempo para tudo
# ----------------------------------------------------------------------------
class Pulso(QObject):
    """
    tick    → ~10 vezes por segundo, para animações (ponteiros, arco).
    segundo → uma vez por segundo, para textos e alarmes.
    """

    tick = Signal(object)
    segundo = Signal(object)

    def __init__(self):
        super().__init__()
        self._ultimo_segundo = -1
        self._timer = QTimer(self)
        self._timer.setInterval(100)
        self._timer.timeout.connect(self._emitir)
        self._timer.start()

    def _emitir(self):
        agora = datetime.now()
        self.tick.emit(agora)
        if agora.second != self._ultimo_segundo:
            self._ultimo_segundo = agora.second
            self.segundo.emit(agora)


# ----------------------------------------------------------------------------
# Serviço de alarmes (independe de qual tela está aberta)
# ----------------------------------------------------------------------------
class Alarmes(QObject):
    disparou = Signal(str, str)  # título, horário
    alterado = Signal()          # lista mudou (ex.: alarme "uma vez" desligou)

    def __init__(self, pulso: Pulso, cfg: dict):
        super().__init__()
        self.cfg = cfg
        self._ultimo_minuto = ""
        self._sonecas: list[tuple[datetime, str]] = []
        pulso.segundo.connect(self._verificar)

    def _verificar(self, agora: datetime):
        minuto = agora.strftime("%Y-%m-%d %H:%M")
        if minuto != self._ultimo_minuto:  # checa uma vez por minuto
            self._ultimo_minuto = minuto
            hhmm = agora.strftime("%H:%M")
            mudou = False
            for al in self.cfg["alarmes"]:
                if not al["ativo"] or al["hora"] != hhmm:
                    continue
                if al["repeticao"] == "uteis" and agora.weekday() >= 5:
                    continue
                self.disparou.emit(al["rotulo"] or "Alarme", hhmm)
                if al["repeticao"] == "uma_vez":
                    al["ativo"] = False
                    mudou = True
            if mudou:
                salvar_config(self.cfg)
                self.alterado.emit()

        vencidas = [s for s in self._sonecas if agora >= s[0]]
        for item in vencidas:
            self._sonecas.remove(item)
            self.disparou.emit(item[1], agora.strftime("%H:%M"))

    def agendar_soneca(self, titulo: str):
        quando = datetime.now() + timedelta(minutes=self.cfg["soneca_min"])
        self._sonecas.append((quando, titulo))

    def testar(self):
        self.disparou.emit("Teste de alarme", datetime.now().strftime("%H:%M"))


# ----------------------------------------------------------------------------
# Avisos (não bloqueantes, com bipe e soneca)
