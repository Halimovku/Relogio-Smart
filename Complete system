        saud = "Bom dia" if 5 <= h < 12 else "Boa tarde" if 12 <= h < 18 else "Boa noite"
        definir_texto(self.saudacao, f"{saud}, {self._usuario}!" if self._usuario else f"{saud}!")

        segundos_dia = h * 3600 + agora.minute * 60 + agora.second
        valor = int(segundos_dia / 86400 * 1000)
        if self.progresso.value() != valor:
            self.progresso.setValue(valor)

        nome_fer, data_fer = proximo_feriado(hoje)
        faltam = (data_fer - hoje).days
        quando = "hoje" if faltam == 0 else f"em {faltam} dia{'s' if faltam != 1 else ''}"
        fim_ano = (date(agora.year, 12, 31) - hoje).days
