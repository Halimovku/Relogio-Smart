_ABERTOS: list = []


class DialogoAviso(QDialog):
    soneca = Signal()

    def __init__(self, titulo: str, mensagem: str, com_soneca: bool):
        super().__init__()
        self.setWindowTitle(titulo)
        self.setWindowFlags(Qt.WindowType.Window | Qt.WindowType.WindowStaysOnTopHint)
        self.setMinimumWidth(340)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(28, 24, 28, 20)
        lay.setSpacing(14)

        icone = QLabel("⏰")
        icone.setAlignment(Qt.AlignmentFlag.AlignCenter)
        icone.setStyleSheet("font-size: 44pt;")
        texto = QLabel(mensagem)
        texto.setAlignment(Qt.AlignmentFlag.AlignCenter)
        texto.setWordWrap(True)
        fonte = QFont("Segoe UI", 15)
        fonte.setBold(True)
        texto.setFont(fonte)
        lay.addWidget(icone)
        lay.addWidget(texto)

        botoes = QHBoxLayout()
        if com_soneca:
            btn_soneca = QPushButton("Soneca")
            btn_soneca.clicked.connect(self._pedir_soneca)
            botoes.addWidget(btn_soneca)
        btn_ok = QPushButton("Desligar" if com_soneca else "OK")
        btn_ok.setObjectName("primario")
        btn_ok.clicked.connect(self.accept)
        botoes.addWidget(btn_ok)
        lay.addLayout(botoes)

        # Bipe a cada 1,2 s por até 60 s
        self._beep = QTimer(self)
        self._beep.setInterval(1200)
        self._beep.timeout.connect(lambda: QApplication.beep())
        self._beep.start()
        self._limite = QTimer(self)
        self._limite.setSingleShot(True)
        self._limite.timeout.connect(self._beep.stop)
        self._limite.start(60_000)
        QApplication.beep()

    def _pedir_soneca(self):
        self.soneca.emit()
        self.accept()

    def done(self, resultado):
        self._beep.stop()
        super().done(resultado)


def _fechar_aviso(dlg: QDialog):
    if dlg in _ABERTOS:
        _ABERTOS.remove(dlg)
    dlg.deleteLater()


def abrir_aviso(titulo: str, mensagem: str, com_soneca: bool = False, ao_soneca=None):
    dlg = DialogoAviso(titulo, mensagem, com_soneca)
    if ao_soneca is not None:
        dlg.soneca.connect(ao_soneca)
    _ABERTOS.append(dlg)
    dlg.finished.connect(lambda _=None, d=dlg: _fechar_aviso(d))
    dlg.show()
    dlg.raise_()
    dlg.activateWindow()


# ----------------------------------------------------------------------------
# Mostrador analógico: rosto pré-renderizado + ponteiros a cada frame
# ----------------------------------------------------------------------------
class MostradorRelogio(QWidget):
    DESENHO = 500  # área de desenho de referência (raio máx. ≈ 250)

    def __init__(self):
        super().__init__()
        self._agora = datetime.now()
        self._rosto: QPixmap | None = None
        self._chave_rosto = None
        self.setMinimumSize(300, 300)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)

    def atualizar(self, agora: datetime):
        self._agora = agora
        self.update()

    def _transformar(self, p: QPainter, largura: float, altura: float):
        lado = min(largura, altura)
        p.translate(largura / 2, altura / 2)
        p.scale(lado / self.DESENHO, lado / self.DESENHO)

    def _desenhar_rosto(self, dia: int) -> QPixmap:
        """Caixa, coroa, mostrador, marcas, números e janela de data: só muda por tamanho ou dia."""
        dpr = self.devicePixelRatioF()
        w, h = self.width(), self.height()
        pixmap = QPixmap(max(1, int(w * dpr)), max(1, int(h * dpr)))
        pixmap.setDevicePixelRatio(dpr)
        pixmap.fill(QColor(0, 0, 0, 0))

        p = QPainter(pixmap)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        self._transformar(p, w, h)

        # Sombra projetada
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 150))
        p.drawEllipse(QPointF(0, 10), 186, 186)

        # Caixa com brilho metálico
        caixa = QRadialGradient(QPointF(-40, -60), 230)
        caixa.setColorAt(0.0, QColor("#4a5a70"))
        caixa.setColorAt(0.55, QColor("#252f3d"))
        caixa.setColorAt(1.0, QColor("#0a0d12"))
        p.setBrush(caixa)
        p.drawEllipse(QPointF(0, 0), 180, 180)

        # Coroa lateral (às 3 horas)
        coroa = QLinearGradient(QPointF(168, 0), QPointF(204, 0))
        coroa.setColorAt(0.0, QColor("#2b3646"))
        coroa.setColorAt(1.0, QColor("#8393a8"))
        p.setBrush(coroa)
        p.drawRoundedRect(QRectF(168, -15, 36, 30), 7, 7)

        # Mostrador
        dial = QRadialGradient(QPointF(-30, -50), 170)
        dial.setColorAt(0.0, QColor("#1a2230"))
        dial.setColorAt(1.0, QColor("#06080c"))
        p.setPen(caneta("#0f141c", 2))
        p.setBrush(dial)
        p.drawEllipse(QPointF(0, 0), 156, 156)

        # Trilha do anel de segundos
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.setPen(caneta("#182131", 6, Qt.PenCapStyle.RoundCap))
        p.drawEllipse(QPointF(0, 0), 128, 128)

        # Marcas de hora e de minuto
        for i in range(60):
            p.save()
            p.rotate(i * 6)
            if i % 5 == 0:
                p.setPen(caneta(COR_TEXTO, 4.5, Qt.PenCapStyle.RoundCap))
                p.drawLine(QPointF(0, -150), QPointF(0, -136))
            else:
                p.setPen(caneta("#3d4a5c", 1.6))
                p.drawLine(QPointF(0, -150), QPointF(0, -143))
            p.restore()

        # Algarismos
        fonte = QFont("Segoe UI", 16)
        fonte.setBold(True)
        p.setFont(fonte)
        p.setPen(QColor(COR_TEXTO))
        for n in range(1, 13):
            ang = math.radians(n * 30)
            x, y = math.sin(ang) * 104, -math.cos(ang) * 104
            p.drawText(QRectF(x - 24, y - 16, 48, 32), Qt.AlignmentFlag.AlignCenter, str(n))

        # Janela de data (entre o centro e as 6 horas)
        janela = QRectF(-20, 46, 40, 26)
        p.setPen(caneta("#2a3444", 1.5))
        p.setBrush(QColor("#0e131b"))
        p.drawRoundedRect(janela, 5, 5)
        fonte_data = QFont("Segoe UI", 12)
        fonte_data.setBold(True)
        p.setFont(fonte_data)
        p.setPen(QColor("#c9d1d9"))
        p.drawText(janela, Qt.AlignmentFlag.AlignCenter, f"{dia:02d}")
        p.end()
        return pixmap

    @staticmethod
    def _mao(p: QPainter, angulo: float, comprimento: float, largura: float, cor: QColor):
        caminho = QPainterPath()
        caminho.moveTo(QPointF(-largura, 16))
        caminho.lineTo(QPointF(-largura, -comprimento + largura * 2))
        caminho.lineTo(QPointF(0, -comprimento))
        caminho.lineTo(QPointF(largura, -comprimento + largura * 2))
        caminho.lineTo(QPointF(largura, 16))
        caminho.closeSubpath()

        # Sombra deslocada (o pivô é deslocado antes de girar)
        p.save()
        p.translate(3, 5)
        p.rotate(angulo)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 120))
        p.drawPath(caminho)
        p.restore()

        p.save()
        p.rotate(angulo)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(cor)
        p.drawPath(caminho)
        p.restore()

    def paintEvent(self, _evento):
        w, h = self.width(), self.height()
        chave = (w, h, self.devicePixelRatioF(), self._agora.day)
        if chave != self._chave_rosto:
            self._rosto = self._desenhar_rosto(self._agora.day)
            self._chave_rosto = chave

        ag = self._agora
        seg = ag.second + ag.microsecond / 1_000_000
        minuto_f = ag.minute + seg / 60
        hora_f = (ag.hour % 12) + minuto_f / 60

        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.drawPixmap(0, 0, self._rosto)
        self._transformar(p, w, h)

        # Anel de progresso dos segundos (gradiente cônico)
        span = -int(seg / 60 * 360 * 16)
        if span:
            conico = QConicalGradient(QPointF(0, 0), 90)
            conico.setColorAt(0.0, QColor("#1f6feb"))
            conico.setColorAt(1.0, QColor("#56d4dd"))
            pen = QPen()
            pen.setWidthF(6.0)
            pen.setCapStyle(Qt.PenCapStyle.RoundCap)
            pen.setBrush(QBrush(conico))
            p.setPen(pen)
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawArc(QRectF(-128, -128, 256, 256), 90 * 16, span)

        self._mao(p, hora_f * 30, 84, 9, QColor(COR_TEXTO))
        self._mao(p, minuto_f * 6, 122, 6, QColor(COR_TEXTO))

        # Ponteiro dos segundos (com contrapeso)
        p.save()
        p.rotate(seg * 6)
        p.setPen(caneta(COR_VERMELHO, 2.2, Qt.PenCapStyle.RoundCap))
        p.drawLine(QPointF(0, 22), QPointF(0, -136))
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(COR_VERMELHO))
        p.drawEllipse(QPointF(0, 18), 6, 6)
        p.restore()

        # Eixo central
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(COR_TEXTO))
        p.drawEllipse(QPointF(0, 0), 9, 9)
        p.setBrush(QColor(COR_VERMELHO))
        p.drawEllipse(QPointF(0, 0), 4, 4)
        p.end()


