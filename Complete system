    COLUNAS = ["Cidade", "Fuso", "Hora", "Data", "Diferença vs. este PC"]

    def __init__(self, pulso: Pulso, cfg: dict):
        super().__init__()
        self.cfg = cfg
        self._zonas_disponiveis = set(available_timezones())
