    def _spin_pomo(self, chave: str, minimo: int, maximo: int, sufixo: str) -> QSpinBox:
        sp = QSpinBox()
        sp.setRange(minimo, maximo)
        sp.setSuffix(f" {sufixo}")
        sp.setValue(int(self.cfg["pomodoro"][chave]))
        sp.valueChanged.connect(lambda v, k=chave: self._salvar_pomo(k, v))
        return sp

    def _salvar_pomo(self, chave: str, valor: int):
        self.cfg["pomodoro"][chave] = int(valor)
        salvar_config(self.cfg)

    def _duracao_manual(self) -> float:
        return self.sp_h.value() * 3600 + self.sp_m.value() * 60 + self.sp_s.value()

    def _mostrar(self, segundos: float):
        definir_texto(self.display, formata_hms(segundos))

    def _ajuste_manual(self, *_):
        if self._fim is None and not self._pomodoro:
            self._restante = self._duracao_manual()
            self._mostrar(self._restante)

    def _atualizar_estado(self):
        if self._pomodoro:
            self.estado.setText(f"🍅 {self._fase}   •   sessões de foco concluídas: {self._sessoes}")
        else:
            self.estado.setText("")

    def _definir_manual_ativo(self, ativo: bool):
        for sp in self._manuais:
            sp.setEnabled(ativo)
        for b in self._botoes_atalho:
            b.setEnabled(ativo)

    def _preset(self, minutos: int):
        if self._pomodoro:
            return
        self.sp_h.setValue(minutos // 60)
        self.sp_m.setValue(minutos % 60)
        self.sp_s.setValue(0)
        self._zerar()

    def _zerar(self):
        self._timer.stop()
        self._fim = None
        self._pomodoro = False
        self._restante = self._duracao_manual()
        self.btn_play.setText("Iniciar")
        self.btn_pomo.setText("🍅 Iniciar Pomodoro")
        self._definir_manual_ativo(True)
        self._atualizar_estado()
        self._mostrar(self._restante)

    def _correr(self):
        self._fim = time.perf_counter() + self._restante
        self._timer.start()

    def _play(self):
        if self._fim is not None:  # está rodando → pausa
            self._restante = max(0.0, self._fim - time.perf_counter())
            self._fim = None
            self._timer.stop()
            self.btn_play.setText("Continuar")
            self._mostrar(self._restante)
            return
        if self._restante <= 0:
            self._restante = self._duracao_manual()
        if self._restante <= 0:
            return
        self._correr()
        self.btn_play.setText("Pausar")

    def _tick(self):
        restante = self._fim - time.perf_counter()
        if restante > 0:
            self._mostrar(restante)
            return
        self._timer.stop()
        self._fim = None
        self._restante = 0.0
        self._mostrar(0)
        self._terminou()

    def _terminou(self):
        if self._pomodoro:
            self._proxima_fase()
        else:
            self.btn_play.setText("Iniciar")
            abrir_aviso("⏲ Temporizador", "Tempo esgotado!")

    def _alternar_pomodoro(self):
        if self._pomodoro:
            self._zerar()
            return
        self._pomodoro = True
        self._fase = "Trabalho"
        self._sessoes = 0
        self._restante = self.cfg["pomodoro"]["trabalho"] * 60.0
        self._definir_manual_ativo(False)
        self._atualizar_estado()
        self._correr()
        self.btn_play.setText("Pausar")
        self.btn_pomo.setText("⏹ Parar Pomodoro")

    def _proxima_fase(self):
        p = self.cfg["pomodoro"]
        if self._fase == "Trabalho":
            self._sessoes += 1
            if self._sessoes % p["ciclos"] == 0:
                self._fase, minutos = "Pausa longa", p["pausa_longa"]
            else:
                self._fase, minutos = "Pausa", p["pausa"]
        else:
            self._fase, minutos = "Trabalho", p["trabalho"]
        self._restante = minutos * 60.0
        self._atualizar_estado()
        abrir_aviso("🍅 Pomodoro", f"Agora: {self._fase} ({minutos} min)")
        self._correr()


class PaginaCalendario(QWidget):
    def __init__(self):
        super().__init__()
        hoje = date.today()

        raiz = QHBoxLayout(self)
        raiz.setContentsMargins(24, 20, 24, 20)
        raiz.setSpacing(24)

        self.cal = QCalendarWidget()
        self.cal.setLocale(QLocale(QLocale.Language.Portuguese, QLocale.Country.Brazil))
        self.cal.setGridVisible(True)
        self.cal.setNavigationBarVisible(True)
        self.cal.setHorizontalHeaderFormat(QCalendarWidget.HorizontalHeaderFormat.ShortDayNames)
        self.cal.setVerticalHeaderFormat(QCalendarWidget.VerticalHeaderFormat.NoVerticalHeader)
        self._fmt_feriado = QTextCharFormat()
        self._fmt_feriado.setForeground(QColor(COR_FERIADO))
        self._fmt_feriado.setFontWeight(700)
        self._marcar_feriados(hoje.year - 1, hoje.year + 2)
        self.cal.currentPageChanged.connect(lambda ano, _mes: self._marcar_feriados(ano - 1, ano + 1))
        raiz.addWidget(self.cal, 3)

        painel = QVBoxLayout()
        painel.setSpacing(8)
        self.titulo = QLabel()
        fonte = QFont("Segoe UI", 18)
        fonte.setBold(True)
        self.titulo.setFont(fonte)
        self.titulo.setWordWrap(True)
        self.detalhes = QLabel()
        self.detalhes.setStyleSheet(f"color: {COR_MUTED};")
        self.detalhes.setWordWrap(True)
        self.rotulo_feriados = QLabel()
        self.rotulo_feriados.setStyleSheet("font-weight: bold; margin-top: 12px;")
        self.lista = QListWidget()
        painel.addWidget(self.titulo)
        painel.addWidget(self.detalhes)
        painel.addWidget(self.rotulo_feriados)
        painel.addWidget(self.lista, 1)
        raiz.addLayout(painel, 2)

        self.cal.selectionChanged.connect(self._atualizar_info)
        self._atualizar_info()

    def _marcar_feriados(self, ano_inicial: int, ano_final: int):
        for ano in range(ano_inicial, ano_final + 1):
            for dia in feriados_nacionais(ano):
                self.cal.setDateTextFormat(QDate(dia.year, dia.month, dia.day), self._fmt_feriado)

    def _atualizar_info(self):
        q = self.cal.selectedDate()
        dia = date(q.year(), q.month(), q.day())
        hoje = date.today()
        feriados = feriados_nacionais(dia.year)

        self.titulo.setText(f"{DIAS_SEMANA[dia.weekday()].capitalize()}, {dia.day} de "
                            f"{MESES[dia.month - 1]} de {dia.year}")

        partes = [f"dia {dia.timetuple().tm_yday} do ano", f"semana ISO {dia.isocalendar().week}"]
        delta = (dia - hoje).days
        if delta == 0:
            partes.append("é hoje")
        elif delta > 0:
            partes.append(f"faltam {delta} dia{'s' if delta != 1 else ''}")
        else:
            partes.append(f"há {-delta} dia{'s' if delta != -1 else ''}")
        if dia in feriados:
            partes.append(f"🎉 {feriados[dia]}")
        self.detalhes.setText("  •  ".join(partes))

        self.rotulo_feriados.setText(f"Feriados de {dia.year}")
        self.lista.clear()
        for d, nome in sorted(feriados.items()):
            self.lista.addItem(f"{d:%d/%m}  ({DIAS_CURTOS[d.weekday()]})  —  {nome}")


def _posicao_visivel(x: int, y: int) -> bool:
    tela = QGuiApplication.primaryScreen()
    if tela is None:
        return False
    return tela.availableGeometry().contains(QPoint(x + 20, y + 20))


class MiniRelogio(QWidget):
    def __init__(self, pulso: Pulso, cfg: dict, ao_restaurar):
        super().__init__()
        self.setWindowFlags(Qt.WindowType.FramelessWindowHint
                            | Qt.WindowType.WindowStaysOnTopHint
                            | Qt.WindowType.Tool)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setFixedSize(240, 112)
        self.setToolTip("Arraste para mover • duplo clique para voltar à janela principal")
        self._cfg = cfg
        self._ao_restaurar = ao_restaurar
        self._arrasto = None

        pos = cfg.get("compacto_pos")
        if isinstance(pos, list) and len(pos) == 2 and _posicao_visivel(int(pos[0]), int(pos[1])):
            self.move(int(pos[0]), int(pos[1]))

        fundo = QFrame(self)
        fundo.setObjectName("mini")
        fundo.setGeometry(0, 0, 240, 112)
        fundo.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)

        raiz = QVBoxLayout(self)
        raiz.setContentsMargins(14, 12, 14, 12)
        raiz.setSpacing(0)

        self.hora = QLabel("00:00:00")
        self.hora.setAlignment(Qt.AlignmentFlag.AlignCenter)
        fonte = QFont("Consolas", 30)
        fonte.setBold(True)
        self.hora.setFont(fonte)
        self.data = QLabel("")
        self.data.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.data.setStyleSheet(f"color: {COR_MUTED}; font-size: 9pt;")
        raiz.addWidget(self.hora)
        raiz.addWidget(self.data)
        fundo.lower()

        pulso.segundo.connect(self._on_segundo)
        self._on_segundo(datetime.now())

    def _on_segundo(self, agora: datetime):
        definir_texto(self.hora, agora.strftime("%H:%M:%S"))
        definir_texto(self.data, f"{DIAS_CURTOS[agora.weekday()]}  •  "
                                 f"{agora.day:02d}/{agora.month:02d}/{agora.year}")

    def mousePressEvent(self, evento):
        if evento.button() == Qt.MouseButton.LeftButton:
            self._arrasto = evento.globalPosition().toPoint() - self.frameGeometry().topLeft()

    def mouseMoveEvent(self, evento):
        if self._arrasto is not None and evento.buttons() & Qt.MouseButton.LeftButton:
            self.move(evento.globalPosition().toPoint() - self._arrasto)

    def mouseReleaseEvent(self, _evento):
        if self._arrasto is not None:
            self._arrasto = None
            self._cfg["compacto_pos"] = [self.x(), self.y()]
            salvar_config(self._cfg)

    def mouseDoubleClickEvent(self, _evento):
        self._ao_restaurar()

    def contextMenuEvent(self, evento):
        menu = QMenu(self)
        menu.addAction("Restaurar janela principal").triggered.connect(lambda _=False: self._ao_restaurar())
        menu.addAction("Sair").triggered.connect(lambda _=False: QApplication.quit())
        menu.exec(evento.globalPos())


class JanelaPrincipal(QMainWindow):
    def __init__(self, pulso: Pulso, cfg: dict):
        super().__init__()
        self.setWindowTitle("Relógio T100 Ultra 3")
        self.setMinimumSize(980, 680)
        janela = cfg["janela"]
        self.resize(max(980, int(janela["largura"])), max(680, int(janela["altura"])))
        self._pulso = pulso
        self._cfg = cfg
        self._anim: QPropertyAnimation | None = None

        self.alarmes = Alarmes(pulso, cfg)
        self.alarmes.disparou.connect(self._aviso_alarme)

        self.pilha = QStackedWidget()
        self.inicio = PaginaInicio(pulso, cfg)
        self.inicio.abrir.connect(self._abrir)
        self.pilha.addWidget(self.inicio)

        self._indices: dict[str, int] = {}
        paginas = [
            ("mundo", "🌍  Mundo", PaginaMundo(pulso, cfg)),
            ("alarmes", "⏰  Alarmes", PaginaAlarmes(cfg, self.alarmes)),
            ("cronometro", "⏱  Cronômetro", PaginaCronometro()),
            ("temporizador", "⏳  Temporizador", PaginaTemporizador(cfg)),
            ("calendario", "📅  Calendário", PaginaCalendario()),
        ]
        for chave, titulo, widget in paginas:
            self._indices[chave] = self.pilha.addWidget(self._com_barra(titulo, widget))
        self.setCentralWidget(self.pilha)

        self._mini = MiniRelogio(pulso, cfg, self._restaurar)

        QShortcut(QKeySequence(Qt.Key.Key_Escape), self).activated.connect(self._ir_inicio)
        QShortcut(QKeySequence("Ctrl+M"), self).activated.connect(self._ir_compacto)

        self.statusBar().showMessage(f"Configurações salvas em: {CONFIG_FILE}")

    def _com_barra(self, titulo: str, widget: QWidget) -> QWidget:
        pagina = QWidget()
        lay = QVBoxLayout(pagina)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)

        barra = QFrame()
        barra.setObjectName("barra")
        barra.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        bl = QHBoxLayout(barra)
        bl.setContentsMargins(20, 12, 20, 12)

        voltar = QPushButton("←  Início")
        voltar.setObjectName("voltar")
        voltar.clicked.connect(self._ir_inicio)

        rotulo = QLabel(titulo)
        rotulo.setObjectName("titulo_pagina")
        hora = QLabel("")
        hora.setObjectName("hora_barra")
        self._pulso.segundo.connect(lambda agora, lb=hora: definir_texto(lb, agora.strftime("%H:%M:%S")))

        bl.addWidget(voltar)
        bl.addSpacing(18)
        bl.addWidget(rotulo)
        bl.addStretch(1)
        bl.addWidget(hora)

        lay.addWidget(barra)
        lay.addWidget(widget, 1)
        return pagina

    def _aviso_alarme(self, titulo: str, hora: str):
        abrir_aviso("⏰ Alarme", f"{titulo}\n{hora}", com_soneca=True,
                    ao_soneca=lambda: self.alarmes.agendar_soneca(titulo))

    def _abrir(self, chave: str):
        if chave == "compacto":
            self._ir_compacto()
        else:
            self._ir(self._indices[chave])

    def _ir_inicio(self):
        self._ir(0)

    def _ir(self, indice: int):
        if self.pilha.currentIndex() == indice:
            return
        self.pilha.setCurrentIndex(indice)
        self._animar(self.pilha.currentWidget())

    def _animar(self, pagina: QWidget):
        if self._anim is not None:
            self._anim.stop()
        efeito = QGraphicsOpacityEffect(pagina)
        pagina.setGraphicsEffect(efeito)
        anim = QPropertyAnimation(efeito, b"opacity")
        anim.setDuration(220)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        anim.start()
        self._anim = anim

    def _ir_compacto(self):
        self.hide()
        self._mini.show()

    def _restaurar(self):
        self._mini.hide()
        self.show()
        self.raise_()
        self.activateWindow()

    def closeEvent(self, evento):
        self._cfg["janela"] = {"largura": self.width(), "altura": self.height()}
        salvar_config(self._cfg)
        super().closeEvent(evento)


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Relógio T100 Ultra 3")
    app.setStyle("Fusion")
    app.setStyleSheet(QSS)

    cfg = carregar_config()
    pulso = Pulso()  # mantém a referência viva durante toda a execução
    janela = JanelaPrincipal(pulso, cfg)
    janela.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
