                      f"Dia {agora.timetuple().tm_yday} do ano  •  faltam {fim_ano} dias para o fim de {agora.year}\n"
                      f"Próximo feriado: {nome_fer} ({data_fer:%d/%m}), {quando}")

        ativos = sum(1 for a in self.cfg["alarmes"] if a["ativo"])
        self.tiles["alarmes"].definir_sub(
            f"{ativos} ativo{'s' if ativos != 1 else ''}" if ativos else "nenhum ativo")
        n_fusos = len(self.cfg["fusos"])
        self.tiles["mundo"].definir_sub(f"{n_fusos} fuso{'s' if n_fusos != 1 else ''} na lista")
        p = self.cfg["pomodoro"]
        self.tiles["temporizador"].definir_sub(f"Pomodoro {p['trabalho']}/{p['pausa']} min")



