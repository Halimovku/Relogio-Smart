class MostradorRelogio(QWidget):
    def __init__(self):
        super().__init__()
        self._agora = datetime.now()
        self.setMinimumSize(300, 300)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)

    def atualizar(self, agora: datetime):
        self._agora = agora
        self.update()

    def paintEvent(self, _evento):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        lado = min(self.width(), self.height())
        p.translate(self.width() / 2, self.height() / 2)
        p.scale(lado / 500, lado / 500)  # desenho pensado em raio 250

        ag = self._agora
        seg = ag.second + ag.microsecond / 1_000_000
        minuto_f = ag.minute + seg / 60
        hora_f = (ag.hour % 12) + minuto_f / 60

        # Sombra projetada
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 150))
        p.drawEllipse(QPointF(0, 10), 186, 186)

        # Caixa com brilho metálico
        bezel = QRadialGradient(QPointF(-40, -60), 230)
        bezel.setColorAt(0.0, QColor("#4a5a70"))
        bezel.setColorAt(0.55, QColor("#252f3d"))
        bezel.setColorAt(1.0, QColor("#0a0d12"))
        p.setBrush(bezel)
        p.drawEllipse(QPointF(0, 0), 180, 180)

        # Coroa lateral (às 3 horas)
        coroa = QLinearGradient(QPointF(168, 0), QPointF(204, 0))
        coroa.setColorAt(0.0, QColor("#2b3646"))
        coroa.setColorAt(1.0, QColor("#8393a8"))
        p.setBrush(coroa)
        p.drawRoundedRect(QRectF(168, -15, 36, 30), 7, 7)

        # Mostrador
        dial = QRadialGradient(QPointF(-30, -50), 170)
        dial.setColorAt(0.0, QColor("#1a2230"))
        dial.setColorAt(1.0, QColor("#06080c"))
        p.setPen(base.caneta("#0f141c", 2))
        p.setBrush(dial)
        p.drawEllipse(QPointF(0, 0), 156, 156)

        # Trilha e progresso do anel de segundos
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.setPen(base.caneta("#182131", 6, Qt.PenCapStyle.RoundCap))
        p.drawEllipse(QPointF(0, 0), 128, 128)

        span = -int(seg / 60 * 360 * 16)
        if span:
            conico = QConicalGradient(QPointF(0, 0), 90)
            conico.setColorAt(0.0, QColor("#1f6feb"))
            conico.setColorAt(1.0, QColor("#56d4dd"))
            pen = QPen()
            pen.setWidthF(6.0)
            pen.setCapStyle(Qt.PenCapStyle.RoundCap)
            pen.setBrush(QBrush(conico))
            p.setPen(pen)
            p.drawArc(QRectF(-128, -128, 256, 256), 90 * 16, span)

        # Marcas de hora e de minuto
        for i in range(60):
            p.save()
            p.rotate(i * 6)
            if i % 5 == 0:
                p.setPen(base.caneta("#e6edf3", 4.5, Qt.PenCapStyle.RoundCap))
                p.drawLine(QPointF(0, -150), QPointF(0, -136))
            else:
                p.setPen(base.caneta("#3d4a5c", 1.6))
                p.drawLine(QPointF(0, -150), QPointF(0, -143))
            p.restore()

        # Algarismos
        fonte = QFont("Segoe UI", 16)
        fonte.setBold(True)
        p.setFont(fonte)
        p.setPen(QColor("#e6edf3"))
        for n in range(1, 13):
            ang = math.radians(n * 30)
            x, y = math.sin(ang) * 104, -math.cos(ang) * 104
            p.drawText(QRectF(x - 24, y - 16, 48, 32), Qt.AlignmentFlag.AlignCenter, str(n))

        # Janela de data (entre o centro e as 6 horas)
        retangulo = QRectF(-20, 46, 40, 26)
        p.setPen(base.caneta("#2a3444", 1.5))
        p.setBrush(QColor("#0e131b"))
        p.drawRoundedRect(retangulo, 5, 5)
        fonte_data = QFont("Segoe UI", 12)
        fonte_data.setBold(True)
        p.setFont(fonte_data)
        p.setPen(QColor("#c9d1d9"))
        p.drawText(retangulo, Qt.AlignmentFlag.AlignCenter, f"{ag.day:02d}")

        # Ponteiros
        self._mao(p, hora_f * 30, 84, 9, QColor("#e6edf3"))
        self._mao(p, minuto_f * 6, 122, 6, QColor("#e6edf3"))

        # Ponteiro dos segundos (com contrapeso)
        p.save()
        p.rotate(seg * 6)
        p.setPen(base.caneta(base.COR_VERMELHO, 2.2, Qt.PenCapStyle.RoundCap))
        p.drawLine(QPointF(0, 22), QPointF(0, -136))
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(base.COR_VERMELHO))
        p.drawEllipse(QPointF(0, 18), 6, 6)
        p.restore()

        # Eixo central
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor("#e6edf3"))
        p.drawEllipse(QPointF(0, 0), 9, 9)
        p.setBrush(QColor(base.COR_VERMELHO))
        p.drawEllipse(QPointF(0, 0), 4, 4)
        p.end()

    @staticmethod
    def _mao(p: QPainter, angulo: float, comprimento: float, largura: float, cor: QColor):
        caminho = QPainterPath()
        caminho.moveTo(QPointF(-largura, 16))
        caminho.lineTo(QPointF(-largura, -comprimento + largura * 2))
        caminho.lineTo(QPointF(0, -comprimento))
        caminho.lineTo(QPointF(largura, -comprimento + largura * 2))
        caminho.lineTo(QPointF(largura, 16))
        caminho.closeSubpath()

        # Sombra deslocada
        p.save()
        p.translate(3, 5)
        p.rotate(angulo)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(0, 0, 0, 120))
        p.drawPath(caminho)
        p.restore()

        # Ponteiro
        p.save()
        p.rotate(angulo)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(cor)
        p.drawPath(caminho)
        p.restore()

class Tile(QFrame):
    clicked = Signal()

    def __init__(self, icone: str, nome: str, sub: str = ""):
        super().__init__()
        self.setObjectName("tile")
        self.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setMinimumSize(170, 118)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(18, 14, 18, 14)
        lay.setSpacing(2)

        ico = QLabel(icone)
        ico.setObjectName("tile_icone")
        self._nome = QLabel(nome)
        self._nome.setObjectName("tile_nome")
        self._sub = QLabel(sub)
        self._sub.setObjectName("tile_sub")

        lay.addWidget(ico)
        lay.addStretch(1)
        lay.addWidget(self._nome)
        lay.addWidget(self._sub)

    def definir_sub(self, texto: str):
        if self._sub.text() != texto:
            self._sub.setText(texto)

    def mouseReleaseEvent(self, evento):
        if evento.button() == Qt.MouseButton.LeftButton and self.rect().contains(evento.position().toPoint()):
            self.clicked.emit()
        super().mouseReleaseEvent(evento)

class PaginaInicio(QWidget):
    abrir = Signal(str)

    APPS = [
        ("mundo", "🌍", "Mundo"),
        ("alarmes", "⏰", "Alarmes"),
        ("cronometro", "⏱", "Cronômetro"),
        ("temporizador", "⏳", "Temporizador"),
        ("calendario", "📅", "Calendário"),
        ("compacto", "⧉", "Modo compacto"),
    ]

    def __init__(self, pulso: base.Pulso, cfg: dict):
        super().__init__()
        self.cfg = cfg
        self._usuario = base.nome_usuario()

        raiz = QHBoxLayout(self)
        raiz.setContentsMargins(28, 24, 28, 24)
        raiz.setSpacing(24)

        cartao = QFrame()
        cartao.setObjectName("cartao")
        cartao_lay = QVBoxLayout(cartao)
        cartao_lay.setContentsMargins(20, 20, 20, 22)
        cartao_lay.setSpacing(4)

        self.mostrador = MostradorRelogio()
        self.hora = QLabel("00:00:00")
        self.hora.setObjectName("hora_grande")
        self.hora.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.data = QLabel("")
        self.data.setObjectName("data_grande")
        self.data.setAlignment(Qt.AlignmentFlag.AlignCenter)
        cartao_lay.addWidget(self.mostrador, 1)
        cartao_lay.addWidget(self.hora)
        cartao_lay.addWidget(self.data)
        raiz.addWidget(cartao, 5)

        lado = QVBoxLayout()
        lado.setSpacing(14)

        marca = QLabel("RELÓGIO T100 ULTRA 3")
        marca.setObjectName("marca")
        self.saudacao = QLabel("")
        self.saudacao.setObjectName("saudacao")
        self.progresso = QProgressBar()
        self.progresso.setRange(0, 1000)
        self.progresso.setFormat("Dia %p% concluído")
        self.progresso.setFixedHeight(26)
        self.info = QLabel("")
        self.info.setObjectName("info")
        self.info.setWordWrap(True)

        grade = QGridLayout()
        grade.setSpacing(14)
        self.tiles: dict[str, Tile] = {}
        for pos, (chave, icone, nome) in enumerate(self.APPS):
            tile = Tile(icone, nome)
            tile.clicked.connect(lambda c=chave: self.abrir.emit(c))
            grade.addWidget(tile, pos // 3, pos % 3)
            self.tiles[chave] = tile
        self.tiles["calendario"].definir_sub("feriados do Brasil")
        self.tiles["compacto"].definir_sub("relógio flutuante")

        lado.addWidget(marca)
        lado.addWidget(self.saudacao)
        lado.addWidget(self.progresso)
        lado.addWidget(self.info)
        lado.addSpacing(8)
        lado.addLayout(grade, 1)
        raiz.addLayout(lado, 6)

        pulso.tick.connect(self._on_tick)
        self._on_tick(datetime.now())

    def _on_tick(self, agora: datetime):
        self.mostrador.atualizar(agora)
        hoje = agora.date()

        self.hora.setText(agora.strftime("%H:%M:%S"))
        self.data.setText(
            f"{base.DIAS_SEMANA[agora.weekday()].capitalize()}, {agora.day} de "
            f"{base.MESES[agora.month - 1]} de {agora.year}"
        )

        h = agora.hour
        saud = "Bom dia" if 5 <= h < 12 else "Boa tarde" if 12 <= h < 18 else "Boa noite"
        self.saudacao.setText(f"{saud}, {self._usuario}!" if self._usuario else f"{saud}!")

        segundos_dia = h * 3600 + agora.minute * 60 + agora.second + agora.microsecond / 1e6
        self.progresso.setValue(int(segundos_dia / 86400 * 1000))

        nome_fer, data_fer = base.proximo_feriado(hoje)
        faltam = (data_fer - hoje).days
        quando = "hoje" if faltam == 0 else f"em {faltam} dia{'s' if faltam != 1 else ''}"
        fim_ano = (date(agora.year, 12, 31) - hoje).days
        self.info.setText(
            f"Dia {agora.timetuple().tm_yday} do ano  •  faltam {fim_ano} dias para o fim de {agora.year}\n"
            f"Próximo feriado: {nome_fer} ({data_fer:%d/%m}), {quando}"
        )

        # Subtítulos dos apps refletem o estado atual
        ativos = sum(1 for a in self.cfg["alarmes"] if a["ativo"])
        self.tiles["alarmes"].definir_sub(
            f"{ativos} ativo{'s' if ativos != 1 else ''}" if ativos else "nenhum ativo")
        n_fusos = len(self.cfg["fusos"])
        self.tiles["mundo"].definir_sub(f"{n_fusos} fuso{'s' if n_fusos != 1 else ''} na lista")
        p = self.cfg["pomodoro"]
        self.tiles["temporizador"].definir_sub(f"Pomodoro {p['trabalho']}/{p['pausa']} min")

class JanelaGUI(QMainWindow):
    def __init__(self, pulso: base.Pulso, cfg: dict):
        super().__init__()
        self.setWindowTitle("Relógio T100 Ultra 3")
        self.resize(1160, 760)
        self.setMinimumSize(980, 680)
        self._pulso = pulso
        self._anim: QPropertyAnimation | None = None

        self.pilha = QStackedWidget()
        self.inicio = PaginaInicio(pulso, cfg)
        self.inicio.abrir.connect(self._abrir)
        self.pilha.addWidget(self.inicio)

        self._indices: dict[str, int] = {}
        modulos = [
            ("mundo", "🌍  Mundo", base.AbaMundo(pulso, cfg)),
            ("alarmes", "⏰  Alarmes", base.AbaAlarmes(pulso, cfg)),
            ("cronometro", "⏱  Cronômetro", base.AbaCronometro()),
            ("temporizador", "⏳  Temporizador", base.AbaTemporizador(cfg)),
            ("calendario", "📅  Calendário", base.AbaCalendario(pulso)),
        ]
        for chave, titulo, widget in modulos:
            self._indices[chave] = self.pilha.addWidget(self._com_barra(titulo, widget))

        self.setCentralWidget(self.pilha)
        self._mini = base.MiniRelogio(pulso, self._restaurar)

        atalho_esc = QShortcut(QKeySequence(Qt.Key.Key_Escape), self)
        atalho_esc.activated.connect(self._ir_inicio)

        self.statusBar().showMessage(f"Configurações salvas em: {base.CONFIG_FILE}")

    def _com_barra(self, titulo: str, widget: QWidget) -> QWidget:
        pagina = QWidget()
        lay = QVBoxLayout(pagina)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)

        barra = QFrame()
        barra.setObjectName("barra")
        barra.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        bl = QHBoxLayout(barra)
        bl.setContentsMargins(20, 12, 20, 12)

        voltar = QPushButton("←  Início")
        voltar.setObjectName("voltar")
        voltar.clicked.connect(self._ir_inicio)

        rotulo = QLabel(titulo)
        rotulo.setObjectName("titulo_pagina")
        hora = QLabel("")
        hora.setObjectName("hora_barra")
        self._pulso.tick.connect(lambda agora, lb=hora: lb.setText(agora.strftime("%H:%M:%S")))

        bl.addWidget(voltar)
        bl.addSpacing(18)
        bl.addWidget(rotulo)
        bl.addStretch(1)
        bl.addWidget(hora)

        lay.addWidget(barra)
        lay.addWidget(widget, 1)
        return pagina


    def _abrir(self, chave: str):
        if chave == "compacto":
            self._ir_compacto()
        else:
            self._ir(self._indices[chave])

    def _ir_inicio(self):
        self._ir(0)

    def _ir(self, indice: int):
        if self.pilha.currentIndex() == indice:
            return
        self.pilha.setCurrentIndex(indice)
        self._animar(self.pilha.currentWidget())

    def _animar(self, pagina: QWidget):
        if self._anim is not None:
            self._anim.stop()
        efeito = QGraphicsOpacityEffect(pagina)
        pagina.setGraphicsEffect(efeito)
        anim = QPropertyAnimation(efeito, b"opacity")
        anim.setDuration(220)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.Type.OutCubic)
        anim.start()
        self._anim = anim

    def _ir_compacto(self):
        self.hide()
        self._mini.show()

    def _restaurar(self):
        self._mini.hide()
        self.show()
        self.raise_()
        self.activateWindow()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Relógio T100 Ultra 3")
    app.setStyle("Fusion")
    app.setStyleSheet(base.QSS + EXTRA_QSS)

    cfg = base.carregar_config()
    pulso = base.Pulso()  # mantém a referência viva durante toda a execução
    janela = JanelaGUI(pulso, cfg)
    janela.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
